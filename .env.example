# Copy to .env and adapt these examples to your host and LAN.
GATEWAY_IP=192.168.1.126
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
MACVLAN_PARENT=eth0
GATEWAY_HOSTNAME=snapcast-gateway
SNAPCAST_IMAGE=snapcast-all-in-one:local
CONTAINER_NAME=snapcast

# Host paths. Relative paths are resolved from docker-compose.yml.
CONFIG_DIR=./config
DATA_DIR=./data
CERTS_DIR=./certs
MEDIA_ROOT=/path/to/media-root

# Container process identity and internal web ports.
PUID=1000
PGID=1000
WEB_PORT=1781
CONTROL_INTERNAL_PORT=1783
MYMPD_INTERNAL_PORT=1782

# Optional HTTPS on the unified WEB_PORT. Certificate paths are in-container.
WEB_TLS_ENABLED=false
TLS_CERT=/app/certs/fullchain.pem
TLS_KEY=/app/certs/privkey.pem

# Authentication is enabled by default. Use a long, unique password.
CONTROL_AUTH_ENABLED=true
CONTROL_USERNAME=admin
CONTROL_PASSWORD=replace-with-a-long-random-password
CONTROL_SESSION_TTL=43200
